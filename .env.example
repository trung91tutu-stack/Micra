# ==========================================================
#  Sao chép tệp này thành .env rồi điền khóa của bạn:
#      cp .env.example .env          (Windows: copy .env.example .env)
#  TUYỆT ĐỐI không đưa tệp .env lên GitHub hay gửi kèm bài dự thi.
# ==========================================================

# Chọn nhà cung cấp: mock | gemini | anthropic | openai
#   mock   = chạy được ngay, không cần khóa, không tốn tiền
#   gemini = CÓ GÓI MIỄN PHÍ — khuyến nghị cho sinh viên
MICRA_LLM=mock

# --- Gemini (miễn phí) — lấy khóa tại https://aistudio.google.com/apikey ---
GEMINI_API_KEY=

# --- Trả phí, chỉ điền nếu dùng ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Tuỳ chọn: đổi mô hình
MICRA_MODEL_GEMINI=gemini-2.5-flash
MICRA_MODEL_ANTHROPIC=claude-sonnet-5
MICRA_MODEL_OPENAI=gpt-4.1-mini

# Số lượt gọi tối đa mỗi phút — đặt THẤP HƠN hạn mức của gói bạn dùng.
# Gói miễn phí Gemini: flash-lite 15 | flash 10 | pro 5
MICRA_RPM=8
